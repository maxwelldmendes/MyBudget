@using MyBudget.ViewModel
@model ClassOfAccountsViewModel


<div class="container mt-4">
    <div class="row">
        <div class="col-md-8 offset-md-2">
            <div class="card">
                <div class="card-header bg-primary text-white text-center">
                    <h2>Do you want to delete this Class of Accounts?</h2>
                </div>

                <div class="card-body">
                    <dl class="row mb-4">
                        <dt class="col-sm-3">Id</dt>
                        <dd class="col-sm-9">@Model.Id</dd>

                        <dt class="col-sm-3">Sub-group</dt>
                        <dd class="col-sm-9">@Model.SubGroupId</dd>

                        <dt class="col-sm-3">Class Code</dt>
                        <dd class="col-sm-9">@Model.ClassCode</dd>

                        <dt class="col-sm-3">Class Description</dt>
                        <dd class="col-sm-9">@Model.ClassDescription</dd>
                    </dl>

                    <form asp-controller="ClassOfAccounts" asp-action="Delete" method="post">
                        <input type="hidden" asp-for="Id" />
                        <input type="hidden" asp-for="SubGroupId" />
                        <input type="hidden" asp-for="ClassCode" />
                        <input type="hidden" asp-for="ClassDescription" />

                        <div class="d-flex justify-content-between">
                            <button type="submit" class="btn btn-danger">Delete</button>
                            <a asp-controller="ClassOfAccounts" asp-action="Index" class="btn btn-warning">Cancel</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
@using MyBudget.ViewModel
@model ClassOfAccountsViewModel


<div class="container mt-4">
    <div class="row">
        <div class="col-md-8 offset-md-2">
            <div class="card">
                <div class="card-header bg-primary text-white text-center">
                    <h2>Edit Class of Accounts</h2>
                </div>

                <div class="card-body">
                    <form asp-controller="ClassOfAccounts" asp-action="Edit" method="post">

                        <div asp-validation-summary="All" class="text-danger">
                        </div>

                        <div class="form-group mb-3">
                            <label asp-for="SubGroupId" class="form-label">Sub-group</label>
                            <select asp-for="SubGroupId" asp-items="Model.SubGroups" class="form-select"
                                    id="validationSubGroupId" required>
                                <option value="">Choose a subgroup...</option>
                            </select>
                            <span asp-validation-for="SubGroupId" class="text-danger"></span>
                        </div>

                        <div class="form-group mb-3">
                            <label asp-for="ClassCode" class="form-label">Class Code</label>
                            <input asp-for="ClassCode" class="form-control" placeholder="Enter the Class Code"
                                   required />
                            <span asp-validation-for="ClassCode" class="text-danger"></span>
                        </div>

                        <div class="form-group mb-3">
                            <label asp-for="ClassDescription" class="form-label">
                                Class Description
                            </label>
                            <input type="text" asp-for="ClassDescription" class="form-control"
                                   placeholder="Enter the Class Description" />
                            <span asp-validation-for="ClassDescription" class="text-danger"></span>
                        </div>

                        <div class="d-flex justify-content-between">
                            <button type="submit" class="btn btn-primary">Apply Changes</button>
                            <a asp-controller="ClassOfAccounts" asp-action="Index" class="btn btn-warning">Cancel</a>
                        </div>

                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
@using MyBudget.ViewModel
@model SubGroupOfAccountsViewModel

<div class="container mt-4">
    <div class="row">
        <div class="col-md-8 offset-md-2">
            <div class="card">
                <div class="card-header bg-primary text-white text-center">
                    <h2>Delete Sub-Group of Accounts</h2>
                </div>

                <div class="card-body">

                    <dl class="row mb-4">
                        <dt class="col-sm-3">Id</dt>
                        <dd class="col-sm-9">@Model.Id</dd>

                        <dt class="col-sm-3">Sub-Group Description</dt>
                        <dd class="col-sm-9">@Model.SubGroupDescription</dd>
                    </dl>

                    <form asp-controller="SubGroupOfAccounts" asp-action="Delete" method="post">
                        <input type="hidden" asp-for="Id" />
                        <input type="hidden" asp-for="SubGroupDescription" />

                        <div asp-validation-summary="All" class="text-danger">
                        </div>

                        <div class="d-flex justify-content-between">
                            <button type="submit" class="btn btn-danger">Delete</button>
                            <a asp-controller="SubGroupOfAccounts" asp-action="Index" class="btn btn-warning">Cancel</a>
                        </div>
                    </form>

                </div>
            </div>
        </div>
    </div>

    @section Scripts {
        <partial name="_ValidationScriptsPartial" />
    }
</div>
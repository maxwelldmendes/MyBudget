@using MyBudget.ViewModel
@model SubGroupOfAccountsViewModel


<div class="container mt-4">
    <div class="row">
        <div class="col-md-8 offset-md-2">
            <div class="card">
                <div class="card-header bg-primary text-white text-center">
                    <h2>Add Sug-group of Accounts</h2>
                </div>

                <div class="card-body">
                    <form asp-controller="SubgroupOfAccounts" asp-action="Create" method="post">
                        @Html.AntiForgeryToken()

                        <input asp-for="Id" type="hidden" />

                        <div asp-validation-summary="All" class="text-danger">
                        </div>

                        <div class="form-group mb-3">
                            <label asp-for="SubGroupDescription" class="form-label">Sub-group</label>
                            <input asp-for="SubGroupDescription" class="form-control" id="validationSubGroupDescription"
                                   placeholder="Enter the Group..." required />
                            <span asp-validation-for="SubGroupDescription" class="text-danger"></span>
                        </div>

                        <div class="form-group mb-3">
                            <label asp-for="GroupId" class="form-label">Group</label>

                            <select asp-for="GroupId" asp-items="Model.Groups" class="form-select"
                                    id="validationSubGroupId" required>

                                <option value="">Select a group...</option>
                            </select>
                            <span asp-validation-for="GroupId" class="text-danger"></span>

                        </div>

                        <div class="d-flex justify-content-between">
                            <button type="submit" class="btn btn-primary">Apply</button>
                            <a asp-controller="SubGroupOfAccounts" asp-action="Index" class="btn btn-warning">Cancel</a>
                        </div>

                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
